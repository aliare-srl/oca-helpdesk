<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ais_helpdesk_whatsapp.WhatsappDashboard" owl="1">
    <div t-attf-class="o_ais_whatsapp_dashboard {{ selectedConversation ? 'has-selection' : '' }}">

        <div class="o_ais_whatsapp_topbar">
            <div class="o_ais_whatsapp_topbar_title">
                <span class="o_ais_whatsapp_title">Mesa de ayuda</span>
                <span class="o_ais_whatsapp_subtitle">Aliare</span>
            </div>
            <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="openStartModal">
                + Iniciar conversación
            </button>
            <div class="o_ais_whatsapp_avatar_name">
                <div class="o_ais_whatsapp_avatar" t-esc="nameInitials(userService.name)" />
                <span t-esc="userService.name" />
            </div>
        </div>

        <div t-if="state.budget.exceeded" class="o_ais_whatsapp_banner budget">
            <div>
                <strong t-esc="'El agente de IA está desactivado: se alcanzó el tope de gasto mensual (USD ' + state.budget.spent.toFixed(2) + ' de USD ' + state.budget.limit.toFixed(2) + ')'" />
                <span>Las conversaciones nuevas esperan a una persona. Se reactiva el día 1 del mes o al subir el tope en Ajustes.</span>
            </div>
        </div>

        <div t-if="urgentWaiting.length" class="o_ais_whatsapp_banner urgent">
            <div>
                <strong t-esc="'🚨 URGENCIA esperando: ' + urgentWaiting.length"/>
                <span t-esc="'#' + urgentWaiting[0].id + ' ' + contactLabel(urgentWaiting[0]) + ' · desde ' + dateTimeLabel(urgentWaiting[0].last_message_at)" />
            </div>
            <button type="button" class="o_ais_whatsapp_btn_urgent" t-on-click="() => this.selectConversation(urgentWaiting[0].id)">Ver</button>
        </div>

        <div t-if="myDelegations.length" class="o_ais_whatsapp_banner info">
            <div><strong t-esc="'Tenés ' + myDelegations.length + (myDelegations.length === 1 ? ' conversación delegada' : ' conversaciones delegadas') + ' para aceptar'" /></div>
            <button type="button" class="o_ais_whatsapp_btn_primary" t-on-click="() => this.selectConversation(myDelegations[0].id)">Ver</button>
        </div>

        <div class="o_ais_whatsapp_body">

            <div class="o_ais_whatsapp_list">
                <div class="o_ais_whatsapp_search">
                    <input
                        type="text"
                        placeholder="Buscar cliente, número, #conversación o texto de los mensajes"
                        t-att-value="state.searchQuery"
                        t-on-input="onSearchInput"
                    />
                </div>
                <div class="o_ais_whatsapp_daterange">
                    <input type="date" t-model="state.dateFrom" aria-label="Desde" />
                    <span>a</span>
                    <input type="date" t-model="state.dateTo" aria-label="Hasta" />
                    <button type="button" class="o_ais_whatsapp_tab" t-on-click="resetDateToday">Hoy</button>
                </div>
                <div class="o_ais_whatsapp_tabs">
                    <button
                        type="button"
                        t-attf-class="o_ais_whatsapp_tab {{ state.filterTab === 'esperando' ? 'active' : '' }}"
                        t-on-click="() => this.setFilterTab('esperando')"
                    >Esperando · <t t-esc="esperandoCount" /></button>
                    <button
                        type="button"
                        t-attf-class="o_ais_whatsapp_tab {{ state.filterTab === 'ia' ? 'active' : '' }}"
                        t-on-click="() => this.setFilterTab('ia')"
                    >IA · <t t-esc="iaCount" /></button>
                    <button
                        type="button"
                        t-attf-class="o_ais_whatsapp_tab {{ state.filterTab === 'persona' ? 'active' : '' }}"
                        t-on-click="() => this.setFilterTab('persona')"
                    >Persona · <t t-esc="personaCount" /></button>
                    <button
                        type="button"
                        t-attf-class="o_ais_whatsapp_tab {{ state.filterTab === 'cerradas' ? 'active' : '' }}"
                        t-on-click="() => this.setFilterTab('cerradas')"
                    >Cerradas · <t t-esc="cerradasCount" /></button>
                    <button
                        type="button"
                        t-attf-class="o_ais_whatsapp_tab {{ state.filterTab === 'todas' ? 'active' : '' }}"
                        t-on-click="() => this.setFilterTab('todas')"
                    >Todas · <t t-esc="todasCount" /></button>
                </div>
                <div t-if="state.loading" class="o_ais_whatsapp_muted p-3">Cargando...</div>
                <div t-if="state.error" class="o_ais_whatsapp_error m-2" t-esc="state.error" />
                <div t-if="!state.loading and !state.error and !filteredConversations.length" class="o_ais_whatsapp_muted p-3">
                    No hay conversaciones.
                </div>
                <div class="o_ais_whatsapp_list_items">
                    <div
                        t-foreach="filteredConversations"
                        t-as="conversation"
                        t-key="conversation.id"
                        t-on-click="() => this.selectConversation(conversation.id)"
                        t-attf-class="o_ais_whatsapp_item {{ conversation.id === state.selectedId ? 'selected' : '' }} {{ conversation.is_urgent and conversation.status === 'waiting_human' ? 'urgent' : '' }}"
                    >
                        <div class="o_ais_whatsapp_item_row">
                            <strong><span class="o_ais_whatsapp_item_number" t-esc="'#' + conversation.id" /> <t t-esc="contactLabel(conversation)" /></strong>
                            <span class="o_ais_whatsapp_time" t-esc="dateTimeLabel(conversation.last_message_at)" />
                        </div>
                        <span class="o_ais_whatsapp_item_preview" t-esc="conversation.last_message_preview" />
                        <span t-if="state.globalMatches[conversation.id]" class="o_ais_whatsapp_item_match" t-esc="matchLabel(conversation)" />
                        <div class="o_ais_whatsapp_item_pills">
                            <span
                                class="o_ais_whatsapp_pill"
                                t-attf-style="background:{{statusPill(conversation.status).bg}};color:{{statusPill(conversation.status).color}};border-color:{{statusPill(conversation.status).border}};"
                                t-esc="statusLabel(conversation)"
                            />
                            <span t-if="conversation.is_urgent and conversation.status === 'waiting_human'" class="o_ais_whatsapp_pill o_ais_whatsapp_pill_urgent">🚨 URGENTE</span>
                        </div>
                    </div>
                </div>
            </div>

            <div t-if="!selectedConversation" class="o_ais_whatsapp_placeholder">
                Elegí una conversación de la izquierda.
            </div>
            <t t-else="">
                <div class="o_ais_whatsapp_chat">
                    <div class="o_ais_whatsapp_chat_header">
                        <button type="button" class="o_ais_whatsapp_back" t-on-click="backToList" aria-label="Volver a la lista">←</button>
                        <div class="o_ais_whatsapp_avatar lg" t-esc="initials(selectedConversation)" />
                        <div class="o_ais_whatsapp_chat_header_info">
                            <span class="o_ais_whatsapp_chat_name"><span class="o_ais_whatsapp_item_number" t-esc="'#' + selectedConversation.id" /> <t t-esc="contactLabel(selectedConversation)" /></span>
                            <span class="o_ais_whatsapp_muted" t-esc="(selectedConversation.contact and selectedConversation.contact.wa_id) or ''" />
                        </div>
                        <span
                            class="o_ais_whatsapp_pill lg"
                            t-attf-style="background:{{statusPill(selectedConversation.status).bg}};color:{{statusPill(selectedConversation.status).color}};border-color:{{statusPill(selectedConversation.status).border}};"
                            t-esc="statusLabel(selectedConversation)"
                        />
                        <button t-if="selectedConversation.helpdesk_ticket_id" type="button" class="o_ais_whatsapp_btn_outline o_ais_whatsapp_header_ticket_btn" t-on-click="openTicket">
                            Abrir ticket
                        </button>
                        <button t-if="canReply" type="button" class="o_ais_whatsapp_btn_outline" t-on-click="openCloseModal" t-att-disabled="state.actionPending">
                            Cerrar conversación
                        </button>
                    </div>

                    <div t-if="selectedConversation.status === 'waiting_human'" class="o_ais_whatsapp_banner warn">
                        <div>
                            <strong>La IA pidió ayuda</strong>
                            <div t-esc="'Motivo: ' + (selectedConversation.escalation_reason || 'sin especificar')" />
                        </div>
                    </div>
                    <div t-if="selectedConversation.status === 'ai'" class="o_ais_whatsapp_banner info">
                        <div><strong>La IA está respondiendo.</strong> Estás mirando en vivo.</div>
                    </div>
                    <div t-if="selectedConversation.status === 'human' and state.agentDisabled" class="o_ais_whatsapp_banner info">
                        <div>
                            <strong>El agente de IA está desactivado</strong>
                            <div>Si no respondés a tiempo, la conversación queda esperando a una persona.</div>
                        </div>
                    </div>
                    <div t-if="selectedConversation.status === 'human' and !state.agentDisabled" class="o_ais_whatsapp_banner info">
                        <div>
                            <strong>La IA está en pausa en esta conversación</strong>
                            <div t-esc="'Se reanuda sola en ' + pauseRemainingLabel + ' si no respondés.'" />
                        </div>
                        <button t-if="canReturnToAi" type="button" class="o_ais_whatsapp_btn_outline" t-on-click="returnToAi" t-att-disabled="state.actionPending">
                            Devolver a la IA ahora
                        </button>
                    </div>

                    <div t-if="ownedByOther" class="o_ais_whatsapp_banner warn">
                        <div>
                            <strong t-esc="'La atiende ' + (selectedConversation.taken_by or 'otra persona')" />
                            <div>Nadie más puede responderla ni tomarla hasta que la devuelva o la delegue.</div>
                        </div>
                        <button t-if="state.isAdmin" type="button" class="o_ais_whatsapp_btn_outline" t-on-click="returnToWaiting" t-att-disabled="state.actionPending">
                            Soltar (administrador)
                        </button>
                    </div>
                    <div t-if="incomingDelegation" class="o_ais_whatsapp_banner info">
                        <div>
                            <strong t-esc="(selectedConversation.delegated_by or 'Un compañero') + ' te delegó esta conversación'" />
                            <div>Hasta que la aceptes, sigue siendo de quien la tiene.</div>
                        </div>
                        <button type="button" class="o_ais_whatsapp_btn_primary" t-on-click="acceptDelegation" t-att-disabled="state.actionPending">Aceptar</button>
                        <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="rejectDelegation" t-att-disabled="state.actionPending">Rechazar</button>
                    </div>
                    <div t-if="outgoingDelegation" class="o_ais_whatsapp_banner info">
                        <div>
                            <strong t-esc="'Delegada a ' + selectedConversation.delegated_to_name" />
                            <div>Esperando que la acepte. Mientras tanto sigue siendo tuya.</div>
                        </div>
                        <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="openChatWithDelegate">Chat de Odoo</button>
                        <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="cancelDelegation" t-att-disabled="state.actionPending">Cancelar delegación</button>
                    </div>
                    <div t-if="isMine and !outgoingDelegation" class="o_ais_whatsapp_ownerbar">
                        <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="returnToWaiting" t-att-disabled="state.actionPending">
                            Devolver a esperando persona
                        </button>
                        <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="openDelegate" t-att-disabled="state.actionPending">
                            Delegar
                        </button>
                        <t t-if="state.delegateOpen">
                            <select t-model="state.delegateTo">
                                <option value="">Elegí a quién delegar</option>
                                <option t-foreach="state.team" t-as="user" t-key="user.id" t-att-value="user.id" t-esc="user.name" />
                            </select>
                            <button type="button" class="o_ais_whatsapp_btn_primary" t-on-click="submitDelegate" t-att-disabled="!state.delegateTo or state.actionPending">Delegar</button>
                            <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="() => this.openChatWith(state.delegateTo)" t-att-disabled="!state.delegateTo">Chat de Odoo</button>
                            <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="closeDelegate">Cancelar</button>
                        </t>
                    </div>

                    <div class="o_ais_whatsapp_panelsearch">
                        <input
                            type="text"
                            placeholder="Buscar en la conversación"
                            t-att-value="state.panelQuery"
                            t-on-input="onPanelQueryInput"
                            t-on-keydown="onPanelQueryKeydown"
                        />
                        <t t-if="state.panelQuery.trim()">
                            <span class="o_ais_whatsapp_muted" t-esc="panelCounter" />
                            <button type="button" class="o_ais_whatsapp_btn_outline" title="Anterior (más antigua)" t-on-click="() => this.goToMatch(-1)" t-att-disabled="!panelMatchData.total">↑</button>
                            <button type="button" class="o_ais_whatsapp_btn_outline" title="Siguiente (más reciente)" t-on-click="() => this.goToMatch(1)" t-att-disabled="!panelMatchData.total">↓</button>
                            <button type="button" class="o_ais_whatsapp_btn_outline" title="Cerrar búsqueda" t-on-click="clearPanelSearch">✕</button>
                        </t>
                    </div>

                    <div class="o_ais_whatsapp_messages" t-ref="messages">
                        <div t-if="state.messagesLoading" class="o_ais_whatsapp_muted">Cargando mensajes...</div>
                        <div
                            t-foreach="state.messages"
                            t-as="message"
                            t-key="message.id"
                            t-attf-class="o_ais_whatsapp_message_row {{ senderClass(message.sender) }}"
                        >
                            <span class="o_ais_whatsapp_sender_label" t-esc="senderLabel(message.sender, selectedConversation) + ' · ' + timeLabel(message.timestamp)" />
                            <div t-if="!message.has_media" t-attf-class="o_ais_whatsapp_bubble {{ senderClass(message.sender) }}" t-raw="bodyHtml(message)" />
                            <div t-else="" t-attf-class="o_ais_whatsapp_bubble {{ senderClass(message.sender) }} attachment">
                                <img t-if="message.msg_type === 'image'" class="o_ais_whatsapp_image" t-att-src="mediaUrl(message)" />
                                <a t-else="" class="o_ais_whatsapp_attachment" t-att-href="mediaUrl(message)" target="_blank" rel="noopener">
                                    Ver adjunto (<t t-esc="message.msg_type" />)
                                </a>
                                <span t-if="message.body" t-raw="bodyHtml(message)" />
                            </div>
                        </div>
                    </div>

                    <div t-if="state.messagesError" class="o_ais_whatsapp_error m-2" t-esc="state.messagesError" />
                    <div t-if="state.actionError" class="o_ais_whatsapp_error m-2" t-esc="state.actionError" />

                    <div t-if="canReply" class="o_ais_whatsapp_replybox">
                        <div class="o_ais_whatsapp_quickreplies">
                            <button
                                t-foreach="quickReplies"
                                t-as="qr"
                                t-key="qr"
                                type="button"
                                class="o_ais_whatsapp_chip"
                                t-on-click="() => this.sendQuickReply(qr)"
                                t-att-disabled="state.sending"
                            ><t t-esc="qr" /></button>
                        </div>
                        <div class="o_ais_whatsapp_replyrow">
                            <textarea
                                placeholder="Escribí tu respuesta..."
                                t-model="state.replyText"
                                t-on-keydown="onReplyKeydown"
                                t-att-disabled="state.sending"
                            />
                            <button
                                type="button"
                                class="o_ais_whatsapp_btn_primary"
                                t-on-click="() => this.sendReply()"
                                t-att-disabled="state.sending or !state.replyText.trim()"
                            >Enviar</button>
                        </div>
                    </div>
                    <div t-elif="canTake" class="o_ais_whatsapp_takebar">
                        <span class="o_ais_whatsapp_muted">
                            Nadie está atendiendo esta conversación. Tomala para poder responder.
                        </span>
                        <button type="button" class="o_ais_whatsapp_btn_primary" t-on-click="takeConversation" t-att-disabled="state.actionPending">
                            Tomar conversación
                        </button>
                    </div>
                    <div t-elif="ownedByOther" class="o_ais_whatsapp_takebar">
                        <span class="o_ais_whatsapp_muted" t-esc="'La está atendiendo ' + (selectedConversation.taken_by or 'otra persona') + '. No podés responder ni tomarla.'" />
                    </div>
                </div>

                <div class="o_ais_whatsapp_info">
                    <div class="o_ais_whatsapp_info_section">
                        <span class="o_ais_whatsapp_info_label">Cliente</span>
                        <span class="o_ais_whatsapp_info_title" t-esc="(selectedConversation.contact and selectedConversation.contact.company) or 'Sin empresa'" />
                        <span t-esc="'Contacto: ' + contactName(selectedConversation)" />
                        <span t-esc="'WhatsApp: ' + ((selectedConversation.contact and selectedConversation.contact.wa_id) or '')" />
                    </div>
                    <div t-if="selectedConversation.helpdesk_ticket_id" class="o_ais_whatsapp_info_section">
                        <span class="o_ais_whatsapp_info_label">Ticket en el Helpdesk</span>
                        <span t-if="state.ticketInfo" class="o_ais_whatsapp_info_title">
                            #<t t-esc="state.ticketInfo.number" /> · <t t-esc="state.ticketInfo.name" />
                        </span>
                        <span t-if="state.ticketInfo" class="o_ais_whatsapp_pill" t-esc="state.ticketInfo.stage" />
                        <span t-esc="selectedConversation.taken_by ? ('Asignado a ' + selectedConversation.taken_by) : 'Creado por la IA'" />
                        <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="openTicket">
                            Abrir ticket
                        </button>
                    </div>
                    <div class="o_ais_whatsapp_info_section">
                        <button t-if="canClose and !canReply" type="button" class="o_ais_whatsapp_btn_outline" t-on-click="openCloseModal" t-att-disabled="state.actionPending">
                            Cerrar conversación
                        </button>
                    </div>
                </div>
            </t>
        </div>

        <div t-if="state.startOpen" class="o_ais_whatsapp_modal_backdrop" t-on-click="closeStartModal">
            <div class="o_ais_whatsapp_modal" t-on-click.stop="">
                <div class="o_ais_whatsapp_modal_header">
                    <strong>Iniciar conversación</strong>
                    <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="closeStartModal">×</button>
                </div>
                <div t-if="state.startTicketId" class="o_ais_whatsapp_muted">
                    Vinculada al ticket #<t t-esc="state.startTicketId" />
                </div>
                <label>Buscar contacto de Odoo (con celular cargado)</label>
                <div class="o_ais_whatsapp_partner_search">
                    <input type="text" t-att-value="state.startPartnerQuery" t-on-input="onPartnerQueryInput" placeholder="Nombre, empresa o celular" />
                    <div t-if="state.startPartnerResults.length" class="o_ais_whatsapp_partner_results">
                        <div t-foreach="state.startPartnerResults" t-as="partner" t-key="partner.id" class="o_ais_whatsapp_partner_result" t-on-click="() => this.pickPartner(partner)">
                            <strong t-esc="partner.name" />
                            <span class="o_ais_whatsapp_muted" t-esc="(partner.company ? partner.company + ' · ' : '') + partner.mobile" />
                        </div>
                    </div>
                    <div t-elif="state.startPartnerEmpty" class="o_ais_whatsapp_muted">Ningún contacto con celular coincide. Podés escribir el número abajo.</div>
                </div>
                <label>Número de WhatsApp (con código de país)</label>
                <input type="text" t-model="state.startPhone" t-on-input="onStartPhoneInput" placeholder="5493794000000" />
                <label>Nombre (opcional)</label>
                <input type="text" t-model="state.startName" placeholder="Nombre del contacto" />
                <t t-if="state.startTemplatesLoading">
                    <div class="o_ais_whatsapp_muted">Leyendo las plantillas aprobadas…</div>
                </t>
                <t t-elif="startManual">
                    <div class="o_ais_whatsapp_muted">
                        No se pudo leer la lista de plantillas<t t-if="state.startTemplatesError">: <t t-esc="state.startTemplatesError" /></t>. Escribí el nombre a mano.
                    </div>
                    <label>Plantilla aprobada por Meta</label>
                    <input type="text" t-model="state.startTemplate" placeholder="nombre_de_la_plantilla" />
                    <label>Parámetros de la plantilla (separados por coma, opcional)</label>
                    <input type="text" t-model="state.startParams" placeholder="Laura, #2417" />
                </t>
                <t t-else="">
                    <label>Plantilla</label>
                    <select t-model="state.startTemplateName" t-on-change="onStartTemplateChange">
                        <option value="">Elegí una plantilla</option>
                        <option t-foreach="state.startTemplates" t-as="template" t-key="template.name" t-att-value="template.name" t-esc="template.name" />
                    </select>
                    <div t-if="startTemplateSelected" class="o_ais_whatsapp_template_preview" t-esc="startPreview" />
                    <t t-foreach="state.startValues" t-as="value" t-key="value_index">
                        <label>Variable <t t-esc="value_index + 1" /></label>
                        <input type="text" t-att-value="value" t-on-input="(ev) => this.setStartValue(value_index, ev.target.value)" />
                    </t>
                </t>
                <div t-if="state.startError" class="o_ais_whatsapp_error" t-esc="state.startError" />
                <div class="o_ais_whatsapp_modal_actions">
                    <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="closeStartModal">Cancelar</button>
                    <button type="button" class="o_ais_whatsapp_btn_primary" t-on-click="submitStart" t-att-disabled="state.startSending">
                        Enviar plantilla
                    </button>
                </div>
            </div>
        </div>

        <div t-if="state.closeOpen" class="o_ais_whatsapp_modal_backdrop" t-on-click="closeCloseModal">
            <div class="o_ais_whatsapp_modal" t-on-click.stop="">
                <div class="o_ais_whatsapp_modal_header">
                    <strong>Cerrar conversación</strong>
                    <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="closeCloseModal">×</button>
                </div>
                <label>¿Cómo se resolvió? (queda en el ticket, como guía para casos parecidos)</label>
                <textarea
                    rows="3"
                    t-model="state.closeResolution"
                    placeholder="Ej: no podía facturar porque el diario de ventas estaba bloqueado; se le indicó desbloquearlo y confirmó que funcionó."
                />
                <div t-if="state.closeError" class="o_ais_whatsapp_error" t-esc="state.closeError" />
                <div class="o_ais_whatsapp_modal_actions">
                    <button type="button" class="o_ais_whatsapp_btn_outline" t-on-click="closeCloseModal">Cancelar</button>
                    <button type="button" class="o_ais_whatsapp_btn_primary" t-on-click="submitClose" t-att-disabled="state.actionPending">
                        Cerrar conversación
                    </button>
                </div>
            </div>
        </div>

    </div>
</t>

</templates>
