<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ais_helpdesk_whatsapp.WhatsappDashboard" owl="1">
    <div class="o_ais_whatsapp_dashboard d-flex h-100">
        <div class="o_ais_whatsapp_list border-end" style="overflow-y: auto;">
            <div class="d-flex justify-content-between align-items-center p-2 border-bottom">
                <h5 class="m-0">Conversaciones</h5>
                <button class="btn btn-sm btn-secondary" t-on-click="loadConversations">Actualizar</button>
            </div>
            <div t-if="state.loading" class="p-3 text-muted">Cargando...</div>
            <div t-if="state.error" class="alert alert-danger m-2" t-esc="state.error" />
            <div t-if="!state.loading and !state.error and !state.conversations.length" class="p-3 text-muted">
                No hay conversaciones.
            </div>
            <div
                t-foreach="state.conversations"
                t-as="conversation"
                t-key="conversation.id"
                t-on-click="() => this.selectConversation(conversation.id)"
                t-attf-class="o_ais_whatsapp_item p-2 border-bottom {{ conversation.id === state.selectedId ? 'bg-primary text-white' : '' }}"
                style="cursor: pointer;"
            >
                <div class="d-flex justify-content-between">
                    <strong t-esc="contactLabel(conversation)" />
                    <span t-if="conversation.is_urgent" class="badge bg-danger">Urgente</span>
                </div>
                <div class="small" t-esc="statusLabel(conversation.status)" />
            </div>
        </div>
        <div t-if="!selectedConversation" class="o_ais_whatsapp_detail flex-grow-1 p-3 text-muted">
            Elegí una conversación de la izquierda.
        </div>
        <t t-else="">
            <div class="o_ais_whatsapp_chat d-flex flex-column flex-grow-1 p-2">
                <div class="o_ais_whatsapp_messages flex-grow-1 overflow-auto p-2">
                    <div t-if="state.messagesLoading" class="text-muted">Cargando mensajes...</div>
                    <div
                        t-foreach="state.messages"
                        t-as="message"
                        t-key="message.id"
                        t-attf-class="o_ais_whatsapp_message mb-2 p-2 rounded {{ message.sender === 'customer' ? 'bg-light' : 'bg-primary text-white ms-auto' }}"
                        style="max-width: 75%;"
                    >
                        <div class="small fw-bold" t-esc="senderLabel(message.sender)" />
                        <div t-esc="message.body" style="white-space: pre-wrap;" />
                        <div t-if="message.has_media" class="small text-muted">[adjunto]</div>
                    </div>
                </div>
                <div t-if="state.messagesError" class="alert alert-danger m-2" t-esc="state.messagesError" />
                <div class="o_ais_whatsapp_reply d-flex p-2 border-top">
                    <textarea
                        class="form-control me-2"
                        rows="2"
                        placeholder="Escribí una respuesta..."
                        t-model="state.replyText"
                        t-on-keydown="onReplyKeydown"
                        t-att-disabled="!canReply or state.sending"
                    />
                    <button
                        class="btn btn-primary"
                        t-on-click="sendReply"
                        t-att-disabled="!canReply or state.sending or !state.replyText.trim()"
                    >
                        Enviar
                    </button>
                </div>
            </div>
            <div class="o_ais_whatsapp_info border-start p-3">
                <h5 t-esc="contactLabel(selectedConversation)" />
                <p>Estado: <t t-esc="statusLabel(selectedConversation.status)" /></p>
                <p t-if="selectedConversation.helpdesk_ticket_id">
                    Ticket: #<t t-esc="selectedConversation.helpdesk_ticket_id" />
                </p>
                <div t-if="state.actionError" class="alert alert-danger p-2" t-esc="state.actionError" />
                <div class="d-flex flex-column gap-2">
                    <button
                        t-if="canTake"
                        class="btn btn-primary btn-sm"
                        t-on-click="takeConversation"
                        t-att-disabled="state.actionPending"
                    >Tomar</button>
                    <button
                        t-if="canReturnToAi"
                        class="btn btn-secondary btn-sm"
                        t-on-click="returnToAi"
                        t-att-disabled="state.actionPending"
                    >Devolver a la IA</button>
                    <button
                        t-if="canClose"
                        class="btn btn-outline-danger btn-sm"
                        t-on-click="closeConversation"
                        t-att-disabled="state.actionPending"
                    >Cerrar</button>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
