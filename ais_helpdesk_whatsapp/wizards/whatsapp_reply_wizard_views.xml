<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="whatsapp_reply_wizard_view_form" model="ir.ui.view">
        <field name="name">ais.whatsapp.reply.wizard.view.form</field>
        <field name="model">ais.whatsapp.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Responder por WhatsApp">
                <group>
                    <field name="conversation_id" invisible="1" />
                    <field name="text" placeholder="Escribí la respuesta para el cliente..." />
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
