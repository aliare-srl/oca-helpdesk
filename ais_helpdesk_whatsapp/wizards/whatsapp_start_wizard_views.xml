<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="whatsapp_start_wizard_view_form" model="ir.ui.view">
        <field name="name">ais.whatsapp.start.wizard.view.form</field>
        <field name="model">ais.whatsapp.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Iniciar conversación de WhatsApp">
                <group>
                    <field name="partner_id" />
                    <field name="phone" />
                    <field name="profile_name" />
                    <field name="template_name" />
                    <field name="params" />
                </group>
                <footer>
                    <button name="action_send" type="object" string="Mandar plantilla" class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="whatsapp_start_wizard_action" model="ir.actions.act_window">
        <field name="name">Iniciar conversación de WhatsApp</field>
        <field name="res_model">ais.whatsapp.start.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="whatsapp_start_wizard_menu"
        name="Iniciar conversación"
        parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
        action="whatsapp_start_wizard_action"
        sequence="6"
        groups="helpdesk_mgmt.group_helpdesk_user_own"
    />
</odoo>
