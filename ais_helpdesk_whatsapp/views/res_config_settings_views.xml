<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ais.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="Mesa de Ayuda WhatsApp"
                    string="Mesa de Ayuda WhatsApp"
                    data-key="ais_helpdesk_whatsapp"
                    groups="helpdesk_mgmt.group_helpdesk_manager"
                >
                    <h2>Conexión con el servicio</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ais_whatsapp_service_url" string="URL del servicio" />
                                <div class="text-muted">
                                    URL del servicio AgenteIA-MesadeAyuda-Odoo, sin la barra final.
                                </div>
                                <div class="content-group">
                                    <field
                                        name="ais_whatsapp_service_url"
                                        placeholder="https://mesaayuda.mochipa.com.ar"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ais_whatsapp_panel_api_key" string="Clave de la API" />
                                <div class="text-muted">Header X-Panel-Key que exige el servicio.</div>
                                <div class="content-group">
                                    <field name="ais_whatsapp_panel_api_key" password="True" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Mesa de ayuda</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ais_whatsapp_ai_user_id" string="Usuario de la IA" />
                                <div class="text-muted">
                                    A nombre de quién queda un ticket mientras lo atiende la IA.
                                </div>
                                <div class="content-group">
                                    <field name="ais_whatsapp_ai_user_id" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="ais_whatsapp_inactivity_close_minutes"
                                    string="Minutos de inactividad para cerrar solo"
                                />
                                <div class="text-muted">
                                    Si el cliente no responde en este tiempo, se cierra solo y se le avisa. 0 lo desactiva.
                                </div>
                                <div class="content-group">
                                    <field name="ais_whatsapp_inactivity_close_minutes" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="ais_whatsapp_refresh_seconds"
                                    string="Segundos entre actualizaciones"
                                />
                                <div class="text-muted">Cada cuánto se refresca sola la pantalla de conversaciones.</div>
                                <div class="content-group">
                                    <field name="ais_whatsapp_refresh_seconds" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="ais_whatsapp_waiting_human_alert_minutes"
                                    string="Minutos entre avisos de conversaciones esperando"
                                />
                                <div class="text-muted">
                                    Mientras haya conversaciones esperando a una persona, se avisa al equipo cada este tiempo. 0 lo desactiva.
                                </div>
                                <div class="content-group">
                                    <field name="ais_whatsapp_waiting_human_alert_minutes" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
