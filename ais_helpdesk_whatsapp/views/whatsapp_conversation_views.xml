<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="whatsapp_conversation_view_tree" model="ir.ui.view">
        <field name="name">ais.whatsapp.conversation.view.tree</field>
        <field name="model">ais.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <tree
                string="Conversaciones de WhatsApp"
                decoration-danger="is_urgent"
                decoration-warning="status == 'waiting_human' and not is_urgent"
                decoration-muted="status == 'closed'"
            >
                <field name="is_urgent" invisible="1" />
                <field name="contact_name" />
                <field name="company_name" />
                <field name="wa_id" />
                <field name="status" widget="badge" />
                <field name="ticket_id" />
                <field name="last_message_at" />
            </tree>
        </field>
    </record>

    <record id="whatsapp_conversation_view_form" model="ir.ui.view">
        <field name="name">ais.whatsapp.conversation.view.form</field>
        <field name="model">ais.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversación de WhatsApp">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar" class="btn-secondary" />
                    <button
                        name="action_take"
                        type="object"
                        string="Tomar"
                        class="btn-primary"
                        attrs="{'invisible': [('status', 'in', ('human', 'closed'))]}"
                    />
                    <button
                        name="action_open_reply_wizard"
                        type="object"
                        string="Responder"
                        class="btn-primary"
                        attrs="{'invisible': [('status', '=', 'closed')]}"
                    />
                    <button
                        name="action_return_to_ai"
                        type="object"
                        string="Devolver a la IA"
                        attrs="{'invisible': [('status', '!=', 'human')]}"
                    />
                    <button
                        name="action_close"
                        type="object"
                        string="Cerrar"
                        attrs="{'invisible': [('status', '=', 'closed')]}"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="ai,waiting_human,human,closed" />
                </header>
                <sheet>
                    <field name="is_urgent" invisible="1" />
                    <widget name="web_ribbon" title="Urgente" bg_color="bg-danger" attrs="{'invisible': [('is_urgent', '=', False)]}" />
                    <div class="oe_title">
                        <h1>
                            <field name="contact_name" placeholder="Contacto" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_name" readonly="1" />
                            <field name="wa_id" readonly="1" />
                            <field name="verified" readonly="1" />
                        </group>
                        <group>
                            <field name="ticket_id" readonly="1" />
                            <field name="escalation_category" readonly="1" />
                            <field name="escalation_reason" readonly="1" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="whatsapp_conversation_view_search" model="ir.ui.view">
        <field name="name">ais.whatsapp.conversation.view.search</field>
        <field name="model">ais.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <search string="Conversaciones de WhatsApp">
                <field name="contact_name" />
                <field name="company_name" />
                <field name="wa_id" />
                <filter name="filter_waiting_human" string="Esperando a un humano" domain="[('status', '=', 'waiting_human')]" />
                <filter name="filter_human" string="Atiende un humano" domain="[('status', '=', 'human')]" />
                <filter name="filter_ai" string="Atiende la IA" domain="[('status', '=', 'ai')]" />
                <filter name="filter_urgent" string="Urgentes" domain="[('is_urgent', '=', True)]" />
                <separator />
                <filter name="filter_not_closed" string="No cerradas" domain="[('status', '!=', 'closed')]" />
                <group expand="0" string="Agrupar por">
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}" />
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_name'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="whatsapp_conversation_action" model="ir.actions.act_window">
        <field name="name">Conversaciones de WhatsApp</field>
        <field name="res_model">ais.whatsapp.conversation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_not_closed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay conversaciones sincronizadas. Apretá "Actualizar" en una conversación,
                o esperá a que corra la sincronización automática.
            </p>
        </field>
    </record>

    <record id="whatsapp_dashboard_action" model="ir.actions.client">
        <field name="name">Conversaciones de WhatsApp</field>
        <field name="tag">ais_whatsapp_dashboard</field>
    </record>

    <menuitem
        id="whatsapp_conversation_menu"
        name="Conversaciones de WhatsApp"
        parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
        action="whatsapp_dashboard_action"
        sequence="5"
        groups="helpdesk_mgmt.group_helpdesk_user_team"
    />
</odoo>
