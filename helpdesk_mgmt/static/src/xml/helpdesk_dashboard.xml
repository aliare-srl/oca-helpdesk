<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="helpdesk_mgmt.Dashboard">
        <div class="o_hlp_dashboard">

            <header class="o_hlp_dash_head">
                <h1>Mesa de Ayuda — Tickets Abiertos</h1>
                <p class="text-muted">Estado de SLA y tiempos de espera de los tickets abiertos</p>
            </header>

            <div class="o_hlp_dash_filters">
                <span class="o_hlp_dash_chip" data-preset="today">Hoy</span>
                <span class="o_hlp_dash_chip" data-preset="7d">Últimos 7 días</span>
                <span class="o_hlp_dash_chip" data-preset="30d">Últimos 30 días</span>
                <span class="o_hlp_dash_chip" data-preset="quarter">Este trimestre</span>
                <label class="o_hlp_dash_date_label">Creados desde
                    <input type="date" class="o_hlp_dash_select o_hlp_dash_date_from" t-att-value="dateFrom" />
                </label>
                <label class="o_hlp_dash_date_label">Hasta
                    <input type="date" class="o_hlp_dash_select o_hlp_dash_date_to" t-att-value="dateTo" />
                </label>
                <select class="o_hlp_dash_select o_hlp_dash_team">
                    <option value="">Todos los equipos</option>
                    <t t-foreach="teams" t-as="team" t-key="team.id">
                        <option t-att-value="team.id" t-att-selected="teamId and teamId == team.id ? 'selected' : undefined">
                            <t t-esc="team.name" />
                        </option>
                    </t>
                </select>
                <select class="o_hlp_dash_select o_hlp_dash_category">
                    <option value="">Todas las categorías</option>
                    <t t-foreach="categories" t-as="cat" t-key="cat.id">
                        <option t-att-value="cat.id" t-att-selected="categoryId and categoryId == cat.id ? 'selected' : undefined">
                            <t t-esc="cat.name" />
                        </option>
                    </t>
                </select>
            </div>

            <div class="o_hlp_dash_kpi_row">
                <div class="o_hlp_dash_tile">
                    <div class="label">Tickets abiertos</div>
                    <div class="value"><t t-esc="kpis.openCount" /> <span class="pct">(<t t-esc="kpis.openPct" />%)</span></div>
                </div>
                <div class="o_hlp_dash_tile">
                    <div class="label">🟢 En tiempo</div>
                    <div class="value"><t t-esc="kpis.green" /> <span class="pct">(<t t-esc="kpis.greenPct" />%)</span></div>
                </div>
                <div class="o_hlp_dash_tile">
                    <div class="label">🟡 Próx. a vencer</div>
                    <div class="value"><t t-esc="kpis.yellow" /> <span class="pct">(<t t-esc="kpis.yellowPct" />%)</span></div>
                </div>
                <div class="o_hlp_dash_tile">
                    <div class="label">🔴 Vencidos</div>
                    <div t-attf-class="value #{kpis.red > 0 ? 'tone-critical' : ''}"><t t-esc="kpis.red" /> <span class="pct">(<t t-esc="kpis.redPct" />%)</span></div>
                </div>
                <div class="o_hlp_dash_tile">
                    <div class="label">Tiempo prom. de espera</div>
                    <div class="value"><t t-esc="kpis.avgWaitHours" /> h</div>
                </div>
            </div>

            <div class="o_hlp_dash_grid">
                <div class="o_hlp_dash_card full">
                    <div class="card-head">
                        <div>
                            <h2>Top 10 tickets más demorados</h2>
                            <div class="sub">Tickets abiertos con más horas laborales de espera desde su creación</div>
                        </div>
                    </div>
                    <t t-if="topDelayed.length">
                        <table class="o_hlp_dash_table">
                            <thead>
                                <tr>
                                    <th>Número</th>
                                    <th>Título</th>
                                    <th>Categoría</th>
                                    <th>Cliente</th>
                                    <th>Usuario</th>
                                    <th class="num">Horas de espera</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="topDelayed" t-as="row" t-key="row.number">
                                    <td><t t-esc="row.number" /></td>
                                    <td><t t-esc="row.name" /></td>
                                    <td><t t-esc="row.category" /></td>
                                    <td><t t-esc="row.partner" /></td>
                                    <td><t t-esc="row.user" /></td>
                                    <td class="num"><t t-esc="row.waiting_hours" /> h</td>
                                    <td>
                                        <span t-attf-class="pill #{row.statusClass}"><t t-esc="row.statusLabel" /></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="!topDelayed.length">
                        <div class="o_hlp_dash_empty">No hay tickets abiertos.</div>
                    </t>
                </div>
            </div>

            <div class="o_hlp_dash_grid">
                <div class="o_hlp_dash_card">
                    <div class="card-head">
                        <div>
                            <h2>Abiertos por categoría</h2>
                            <div class="sub">Según filtros seleccionados</div>
                        </div>
                    </div>
                    <t t-if="categoryTable.length">
                        <table class="o_hlp_dash_table">
                            <thead>
                                <tr>
                                    <th>Categoría</th>
                                    <th class="num">Total</th>
                                    <th class="num">En tiempo</th>
                                    <th class="num">Próx. a vencer</th>
                                    <th class="num">Vencidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="categoryTable" t-as="row" t-key="row.id">
                                    <td><t t-esc="row.name" /></td>
                                    <td class="num"><t t-esc="row.total" /></td>
                                    <td class="num"><t t-esc="row.green" /></td>
                                    <td class="num"><t t-esc="row.yellow" /></td>
                                    <td class="num">
                                        <span t-attf-class="pill #{row.riskClass}"><t t-esc="row.red" /></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="!categoryTable.length">
                        <div class="o_hlp_dash_empty">No hay tickets abiertos.</div>
                    </t>
                </div>

                <div class="o_hlp_dash_card">
                    <div class="card-head">
                        <div>
                            <h2>Abiertos por usuario asignado</h2>
                            <div class="sub">Según filtros seleccionados</div>
                        </div>
                    </div>
                    <t t-if="userTable.length">
                        <table class="o_hlp_dash_table">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th class="num">Total</th>
                                    <th class="num">En tiempo</th>
                                    <th class="num">Próx. a vencer</th>
                                    <th class="num">Vencidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="userTable" t-as="row" t-key="row.id">
                                    <td><t t-esc="row.name" /></td>
                                    <td class="num"><t t-esc="row.total" /></td>
                                    <td class="num"><t t-esc="row.green" /></td>
                                    <td class="num"><t t-esc="row.yellow" /></td>
                                    <td class="num">
                                        <span t-attf-class="pill #{row.riskClass}"><t t-esc="row.red" /></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="!userTable.length">
                        <div class="o_hlp_dash_empty">No hay tickets abiertos.</div>
                    </t>
                </div>
            </div>

            <div class="o_hlp_dash_grid">
                <div class="o_hlp_dash_card">
                    <div class="card-head">
                        <div>
                            <h2>Abiertos por cliente</h2>
                            <div class="sub">Según filtros seleccionados</div>
                        </div>
                    </div>
                    <t t-if="partnerTable.length">
                        <table class="o_hlp_dash_table">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th class="num">Total</th>
                                    <th class="num">En tiempo</th>
                                    <th class="num">Próx. a vencer</th>
                                    <th class="num">Vencidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="partnerTable" t-as="row" t-key="row.id">
                                    <td><t t-esc="row.name" /></td>
                                    <td class="num"><t t-esc="row.total" /></td>
                                    <td class="num"><t t-esc="row.green" /></td>
                                    <td class="num"><t t-esc="row.yellow" /></td>
                                    <td class="num">
                                        <span t-attf-class="pill #{row.riskClass}"><t t-esc="row.red" /></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="!partnerTable.length">
                        <div class="o_hlp_dash_empty">No hay tickets abiertos.</div>
                    </t>
                </div>

                <div class="o_hlp_dash_card">
                    <div class="card-head">
                        <div>
                            <h2>Abiertos por prioridad</h2>
                            <div class="sub">Según filtros seleccionados</div>
                        </div>
                    </div>
                    <t t-if="priorityTable.length">
                        <table class="o_hlp_dash_table">
                            <thead>
                                <tr>
                                    <th>Prioridad</th>
                                    <th class="num">Total</th>
                                    <th class="num">En tiempo</th>
                                    <th class="num">Próx. a vencer</th>
                                    <th class="num">Vencidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="priorityTable" t-as="row" t-key="row.id">
                                    <td><t t-esc="row.name" /></td>
                                    <td class="num"><t t-esc="row.total" /></td>
                                    <td class="num"><t t-esc="row.green" /></td>
                                    <td class="num"><t t-esc="row.yellow" /></td>
                                    <td class="num">
                                        <span t-attf-class="pill #{row.riskClass}"><t t-esc="row.red" /></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="!priorityTable.length">
                        <div class="o_hlp_dash_empty">No hay tickets abiertos.</div>
                    </t>
                </div>
            </div>

            <p class="o_hlp_dash_note text-muted">
                Los tiempos se calculan en horas laborales, según el horario configurado en Ajustes de Helpdesk. El rango de fechas filtra por fecha de creación del ticket.
            </p>
        </div>
    </t>

</templates>
